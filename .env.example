DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-string"

# ── Recommended: Ollama (unlimited, runs on your PC) ──
# Install: https://ollama.com/download
# Then: ollama pull llama3.2
OLLAMA_ENABLED="true"
OLLAMA_MODEL="llama3.2"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ── Cloud fallbacks (free tiers have daily limits) ──
# GROQ_API_KEY="gsk-your-key"       # console.groq.com (free)
# GEMINI_API_KEY="your-key"         # aistudio.google.com/apikey (free, limited)
# OPENAI_API_KEY="sk-your-key"      # platform.openai.com (paid)

AI_PROVIDER="auto"
AI_MOCK_MODE="false"

NEXT_PUBLIC_APP_NAME="StudyMate AI"
